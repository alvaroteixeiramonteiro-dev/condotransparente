# This is an example .env file for the Condo Transparente application.
# Template: copy this file to .env and adjust the values for your machine.
# Set SESSION_SECRET to a long random string. Never commit the real .env.
PORTA=3000
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=condotransparente
SESSION_SECRET=change-me-to-a-long-random-string