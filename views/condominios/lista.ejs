<%# List of the logged-in user's condominiums. Rendered by GET /condominios. %>
<%# Variables from routes/condominios.js: titulo (page title) and condominios (array of rows). %>
<%- include('../partials/cabecalho') %>

<h1>Condomínios</h1>

<%# Bar with the total and the button to create a new condominium %>
<div class="barra">
    <span><%= condominios.length %> condomínio(s) registado(s)</span>
    <a href="/condominios/novo" class="btn">+ Novo condomínio</a>
</div>

<table class="tabela">
    <tr>
        <th>Nome</th>
        <th>Morada</th>
        <th>Ocorrências</th>
        <th></th> <%# Empty heading: this column holds the action links (edit; delete comes next) %>
    </tr>
    <%# One row per condominium: everything between forEach and }) repeats %>
    <% condominios.forEach(condominio => { %>
        <tr>
            <td><%= condominio.nome %></td>
            <td><%= condominio.morada %></td>
            <td><%= condominio.total_ocorrencias %></td>
            <%# Actions column: the id in the address tells the server which condominium to edit.
                The server also checks that it belongs to the logged-in user. %>
            <td>
                <div class="acoes">
                    <a href="/condominios/<%= condominio.id_condominio %>/editar">Editar</a>
                </div>
            </td>
        </tr>
    <% }) %>
</table>

<%- include('../partials/rodape') %>